SECTOR = 512
COPY_SIZE = 1024 * 1024
HFS_EPOCH = 2082844800


class ImageError(Exception):
    """The image is malformed or requires a feature we do not support."""


def require(condition, message):
    if not condition:
        raise ImageError(message)


def unpack(fmt, data, offset=0):
    try:
        return struct.unpack_from(fmt, data, offset)
    except struct.error as error:
        raise ImageError("truncated image structure") from error


def checked_slice(data, offset, size):
    require(0 <= offset <= len(data) and 0 <= size <= len(data) - offset,
            "truncated data")
    return data[offset:offset + size]


def copy_match(output, distance, length, limit):
    if not length:
        return
    require(0 < distance <= len(output), "invalid compression match distance")
    require(len(output) + length <= limit, "compressed data exceeds declared size")
    # An overlapping copy repeats the bytes already present at this distance.
    start = len(output) - distance
    if length <= distance:
        output.extend(output[start:start + length])
    else:
        pattern = output[start:]
        repeats, tail = divmod(length, distance)
        output.extend(pattern * repeats)
        output.extend(pattern[:tail])


def decode_adc(data, size, output=None):
    if output is None:
        output = bytearray()
    pos = 0
    while pos < len(data):
        op = data[pos]
        pos += 1
        if op & 0x80:
            length = (op & 0x7f) + 1
            require(len(output) + length <= size, "ADC literals exceed declared size")
            output.extend(checked_slice(data, pos, length))
            pos += length
        else:
            if op & 0x40:
                length = (op & 0x3f) + 4
                distance = unpack(">H", data, pos)[0] + 1
                pos += 2
            else:
                length = (op >> 2) + 3
                distance = ((op & 3) << 8 | checked_slice(data, pos, 1)[0]) + 1
                pos += 1
            copy_match(output, distance, length, size)
    require(len(output) == size, "ADC output size mismatch")
    return output


